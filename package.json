{
	"name": "euchre",
	"private": true,
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*",
		"crates/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"dev:desktop": "turbo run dev --filter=@euchre/desktop",
		"dev:server": "turbo run dev --filter=@euchre/server",
		"dev:web": "turbo run dev --filter=@euchre/web",
		"build": "turbo run build",
		"check": "turbo run check",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"format": "turbo run format"
	},
	"devDependencies": {
		"railway": "3.12.0",
		"turbo": "2.11.10"
	}
}
