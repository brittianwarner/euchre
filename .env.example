# ---------------------------------------------------------------------------
# Rivet Cloud
# ---------------------------------------------------------------------------
# Get both tokens from the Rivet Dashboard (https://dashboard.rivet.dev)
#   -> Settings -> Advanced -> Cloud API Tokens
#
# Both use URL auth syntax: https://<namespace>:<token>@<host>
#
# Topology: the browser opens its WebSocket directly to Rivet Cloud. Rivet Cloud
# then makes ordinary HTTPS requests back to this deployment at /api/rivet/*.
# This app never terminates a WebSocket.

# SERVER ONLY - SECRET. Never expose this. Uses the sk_ token.
# Tells this backend where the Rivet engine is, and is used to verify that
# incoming GET /api/rivet/start requests really came from Rivet.
#
# REQUIRED IN PRODUCTION. Without it RivetKit falls back to its filesystem
# driver, which fails on Vercel's read-only filesystem with:
#   Error: ENOENT: no such file or directory, mkdir '.../rivetkit/.../state'
# Leave it unset locally to run an engine on http://localhost:6420.
RIVET_ENDPOINT=https://your-namespace:sk_xxxx@api.rivet.dev

# PUBLISHED TO THE BROWSER. Uses the pk_ (publishable) token - NOT sk_.
# Served by GET /api/rivet/metadata and surfaced in page data by
# src/routes/+layout.server.ts, so clients know where to open their WebSocket.
# Without it, /api/rivet/metadata returns 200 but omits clientEndpoint,
# clientNamespace, and clientToken, and browser connections never establish.
RIVET_PUBLIC_ENDPOINT=https://your-namespace:pk_xxxx@api.rivet.dev

# LOCAL DEV ONLY. Ours, not a RivetKit builtin. Read by
# src/lib/actors/registry.ts, which is only consulted when RIVET_ENDPOINT is
# unset. The engine RivetKit spawns on :6420 during `bun run dev` cannot guess
# the Vite port, so it is told explicitly. Defaults to the value below; set it
# if you run Vite somewhere other than 5173.
# RIVET_DEV_SERVERLESS_URL=http://localhost:5173/api/rivet

# Optional: if Vercel Deployment Protection is on, create a bypass secret in
# Vercel project settings, then in Rivet go to Settings -> Providers -> Edit
# -> Add Header: x-vercel-protection-bypass = <your secret>. Otherwise Rivet's
# requests to /api/rivet/* get a 401 "Authentication Required".

# SERVER ONLY - SECRET. The deployment-wide actor-to-actor auth token, distinct
# from euchreTable's own per-match internalToken (which is minted fresh in
# createState and never comes from the environment). This one is shared by
# every actor that talks to playerProfile, which outlives any single match and
# so cannot know a per-match secret: euchreTable (recordGame/recordHands),
# aiSeat (recordEpisodes/recordTokens), and playerProfile itself
# (assertInternalToken). All three read it independently rather than importing
# from one another. REQUIRED IN PRODUCTION (>= 16 chars) or every internal
# write to playerProfile is refused. Falls back to the fixed dev-only value
# 'euchre-dev-insecure-secret' when RIVET_ENDPOINT is unset (local dev).
EUCHRE_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# Legacy / superseded
# ---------------------------------------------------------------------------
# This project has NO external database. All durable state lives in Rivet:
# c.state (small bounded blobs), c.kv (unbounded key/value), c.db (actor-local
# SQLite). The variable below only feeds the leftover drizzle scaffolding from
# the SvelteKit skeleton and is slated for removal.
DATABASE_URL=local.db

# ─── AI opponents ────────────────────────────────────────────────────────────
# OpenRouter is the shipped provider for every AI turn (Vercel AI SDK).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Optional overrides. Defaults are google/gemini-3.6-flash for all decisions
# Overridable per tier below.
# OPENROUTER_MODEL_PLAY=google/gemini-3.6-flash
# OPENROUTER_MODEL_BID=google/gemini-3.6-flash
# OPENROUTER_BASE_URL=

# Fallback only: used if OPENROUTER_API_KEY is absent.
# ANTHROPIC_API_KEY=
