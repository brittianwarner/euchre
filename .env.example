# Local development: leave RIVET_ENDPOINT unset for the bundled local engine.
# Railway production: private endpoint, separate namespace and credential.
# RIVET_ENDPOINT=http://rivet-engine.railway.internal:6420
# RIVET_NAMESPACE=euchre
# RIVET_POOL=default
# RIVET_TOKEN=<reference the engine admin token in Railway>
# RIVET_PUBLIC_ENDPOINT=https://your-app.up.railway.app/rivet
# RIVET_ENGINE_SELFHOSTED=true
# RIVETKIT_RUNTIME_MODE=envoy
# RIVET_INSPECTOR_DISABLE=1
# RIVET_LOG_LEVEL=warn
# RIVET_EXPOSE_ERRORS=0
# APP_URL=https://your-app.up.railway.app
# ORIGIN=https://your-app.up.railway.app
# ALLOWED_ORIGINS=https://your-app.up.railway.app
# PORT=3000

# Independent random secrets, at least 32 characters each. Required in production.
# EUCHRE_ACTOR_JWT_SECRET=
# EUCHRE_INTERNAL_TOKEN=

# Local Vite port override only when RIVET_ENDPOINT is unset.
# RIVET_DEV_SERVERLESS_URL=http://localhost:5173/api/rivet

# Legacy / superseded
# ---------------------------------------------------------------------------
# This project has NO external database. All durable state lives in Rivet:
# c.state (small bounded blobs), c.kv (unbounded key/value), c.db (actor-local
# SQLite). The variable below only feeds the leftover drizzle scaffolding from
# the SvelteKit skeleton and is slated for removal.
DATABASE_URL=local.db

# ─── AI opponents ────────────────────────────────────────────────────────────
# Game decisions use typesafe/jev-1.13 exclusively via the OpenRouter Decisions API.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Conventional LLMs are used ONLY for conversational table talk.
# OPENROUTER_MODEL_TALK=google/gemini-3.6-flash
# OPENROUTER_BASE_URL=

# Conversational fallback only; never used to choose game moves.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Optional. Set to 1 to compress every table pause so a full match runs in
# minutes — useful for grinding through games while testing. Leave unset for the
# real table feel (AI think-pauses, trick-collection reads, hand-score beats).
# EUCHRE_FAST_TEMPO=1
