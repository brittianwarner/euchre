{
	"name": "@euchre/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:unit": "vitest",
		"test": "vitest --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"@types/three": "0.185.1",
		"@vitest/browser-playwright": "5.0.3",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "^4.1.17",
		"typescript": "6.0.3",
		"vite": "8.3.2",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@rivetkit/svelte": "workspace:*",
		"@threlte/core": "8.6.1",
		"@threlte/extras": "9.22.0",
		"rivetkit": "3.1.0",
		"three": "0.185.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
